# Non-secret settings for the Render web service (npm run start:render). Values set in the Render dashboard win.
# The only value to enter in the dashboard is OTAPI_KEY (secret, never stored in the repository).
DATA_DIR=data
AUTH_SECRET=auto
COOKIE_SECURE=1
OTAPI_PROVIDER=Aliexpress
OTAPI_LANG=ru
OTAPI_DAILY_CALL_LIMIT=60
IMAGE_HOSTS=alicdn.com,aliexpress-media.com
SITE_USER=cargo
SITE_PASSWORD_SHA256=3608dacb9884097c576af4037394c8e3ff7157ab0a6c7c15eb293ba7fa5f4eb9
PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
