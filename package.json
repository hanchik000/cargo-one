{
  "name": "cargo-one",
  "version": "0.1.0",
  "private": true,
  "description": "CARGO ONE — China. One Platform. China–Turkmenistan commerce, sourcing, supplier payment, cargo and vehicle platform (MVP).",
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "start": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning server/server.mjs",
    "typecheck": "tsc --noEmit",
    "test:e2e": "node scripts/e2e.mjs",
    "test": "node --disable-warning=ExperimentalWarning --test tests/*.test.mjs",
    "catalog:seed-export": "node scripts/export-catalog-seed.mjs",
    "otapi:probe": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning scripts/otapi-probe.mjs"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-icons": "5.7.0",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "0.28.2",
    "playwright": "1.56.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  }
}
