{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 npm install --include=dev --no-audit --no-fund",
  "buildCommand": "node scripts/build-artifact.mjs --pages && (curl -fsSL https://raw.githubusercontent.com/hanchik000/cargo-one/gh-pages/catalog.json -o pages/catalog.json || true)",
  "outputDirectory": "pages",
  "functions": { "api/live-search.mjs": { "maxDuration": 25 } }
}
