# Copy to .env (or set in your hosting environment). Never commit real secrets.
PORT=3000
# Required in production: long random string used to sign session cookies.
AUTH_SECRET=
# Set to 1 when served over HTTPS so cookies get the Secure flag.
COOKIE_SECURE=0
# Demo mode enables demo accounts, mock OAuth and shows mock OTP codes. Set to "off" in production.
DEMO_MODE=on
# Public site URL used for canonical/OG/sitemap.
SITE_URL=https://cargo.one
# Where the user store and the catalogue database (cargo-one.sqlite) live.
DATA_DIR=.data
# Optional explicit path to the SQLite catalogue file (defaults to $DATA_DIR/cargo-one.sqlite).
DB_FILE=
# "off" starts with an empty catalogue instead of seeding the bundled DEMO products.
CATALOG_DEMO_SEED=on
# Imported products whose last successful sync is older than this are marked stale.
CATALOG_STALE_HOURS=72
# Comma-separated https hosts allowed for imported product images (empty = local assets only).
IMAGE_HOSTS=

# --- Future integrations (not wired yet; mock services are used) ---
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=
SMS_PROVIDER_API_KEY=
PAYMENT_PARTNER_API_KEY=
SETTLEMENT_PARTNER_API_KEY=
LOGISTICS_API_KEY=
SUPPLIER_CATALOG_API_KEY=
VEHICLE_DATA_API_KEY=
AI_API_KEY=
DATABASE_URL=

# --- W2: OT Commerce aggregator (third-party data service; not an official marketplace API) ---
# Key from the OT Commerce cabinet. Keep it ONLY here on the server; never in client code or the repository.
OTAPI_KEY=
# Optional request-signing secret (only if your key has one).
OTAPI_SECRET=
OTAPI_PROVIDER=Aliexpress
# Language of translated titles (ru or en).
OTAPI_LANG=ru
# Hard cap of paid calls per UTC day (trial keys have few calls).
OTAPI_DAILY_CALL_LIMIT=60
# For AliExpress images add: IMAGE_HOSTS=alicdn.com   (see IMAGE_HOSTS above; subdomains are included)
